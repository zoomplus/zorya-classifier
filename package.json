{
  "name": "zorya-classifier",
  "version": "0.2.1",
  "description": "Provider-independent classification with experimental localization and object extraction for Node.js",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./openrouter": {
      "types": "./dist/openrouter.d.ts",
      "import": "./dist/openrouter.js"
    },
    "./openai-compatible": {
      "types": "./dist/openai-compatible.d.ts",
      "import": "./dist/openai-compatible.js"
    },
    "./segmentation": {
      "types": "./dist/segmentation.d.ts",
      "import": "./dist/segmentation.js"
    }
  },
  "bin": {
    "zorya-classifier": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE.md",
    "docs"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --import tsx --test --test-concurrency=2 test/*.test.ts",
    "check": "npm run secrets:check && npm run typecheck && npm run lint && npm run boundaries && npm run dead-code:ci && npm test && npm run build",
    "boundaries": "node scripts/boundaries.mjs",
    "dead-code:ci": "knip --no-progress",
    "pack:check": "node scripts/pack-check.mjs",
    "prepare": "husky",
    "secrets:check": "node scripts/secrets.mjs --worktree",
    "secrets:staged": "node scripts/secrets.mjs --staged",
    "prepublishOnly": "npm run check && npm run pack:check && npm run format:check"
  },
  "dependencies": {
    "sharp": "0.34.5",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.3.0",
    "eslint": "9.39.5",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-unicorn": "59.0.1",
    "husky": "9.1.7",
    "knip": "5.62.0",
    "onnxruntime-node": "1.23.2",
    "prettier": "3.6.2",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "typescript-eslint": "8.71.1"
  },
  "author": "zoomplus",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zoomplus/zorya-classifier.git"
  },
  "homepage": "https://github.com/zoomplus/zorya-classifier#readme",
  "bugs": {
    "url": "https://github.com/zoomplus/zorya-classifier/issues"
  },
  "keywords": [
    "classification",
    "image-classification",
    "object-localization",
    "image-localization",
    "bounding-box",
    "object-extraction",
    "image-segmentation",
    "background-removal",
    "decision-models",
    "computer-vision",
    "nodejs",
    "llm",
    "openrouter",
    "typescript",
    "vision",
    "openai-compatible",
    "multimodal",
    "mobile-sam",
    "segment-anything",
    "binary-mask"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "onnxruntime-node": "1.23.2"
  },
  "peerDependenciesMeta": {
    "onnxruntime-node": {
      "optional": true
    }
  }
}
